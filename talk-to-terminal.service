[Unit]
Description=Talk to Terminal — phone dictation and remote control bridge
After=graphical-session.target

[Service]
Type=simple
EnvironmentFile=%h/.config/talk-to-terminal/config.env
ExecStart=/usr/bin/python3 %h/workspace/iphone_dict_capture/linux_listener.py
Restart=on-failure
RestartSec=2

# If xdotool silently does nothing after `systemctl --user start`, the
# service didn't inherit the graphical session's X access. Check with:
#   systemctl --user show-environment | grep -E 'DISPLAY|XAUTHORITY'
# On this box (Mint Cinnamon, X11) the active session uses DISPLAY=:0 and
# XAUTHORITY=%h/.Xauthority — confirm with `echo $DISPLAY $XAUTHORITY` in
# a real desktop terminal, then uncomment below if the service doesn't
# pick them up on its own:
# Environment=DISPLAY=:0
# Environment=XAUTHORITY=%h/.Xauthority

# WantedBy=default.target (not graphical-session.target): on this box
# (Mint Cinnamon) graphical-session.target is never reliably activated by
# the session, so units pulled in only by it never auto-start on login/
# reboot. default.target always fires, and DISPLAY/XAUTHORITY are already
# present in the user systemd instance's environment regardless.
[Install]
WantedBy=default.target
