# Copy to ~/.config/dictation-bridge/config.env and fill in real values.
# That file holds the shared secret — never commit it, keep it out of git.

# This box's LAN IP (never 0.0.0.0 — see project_spec.md section 5).
# Find it with: ip -4 addr show
DICTATION_HOST=192.168.1.14
# 8766, not 8765 — url-opener already holds 8765 on this box (see toolctl status)
DICTATION_PORT=8766

# Shared secret the iOS Shortcut must send in the X-Auth header.
# Generate one with: openssl rand -hex 32
DICTATION_SHARED_SECRET=changeme

# Injection backend: xdotool (X11, default) or ydotool (Wayland — stub only, see injection.py)
DICTATION_BACKEND=xdotool

# Reliability knobs (project_spec.md section 6). Leave at these defaults
# first, then work down this list only if a target — especially a
# terminal / Claude Code session — drops or reorders characters:
#   1. DICTATION_TYPE_DELAY_MS  — per-character delay in xdotool type
#   2. DICTATION_CHUNK_SIZE     — split each line into N-char bursts
#      (DICTATION_CHUNK_PAUSE_MS between bursts)
#   3. DICTATION_INJECTION_MODE=paste — clipboard-paste fallback instead
#      of simulated typing (terminal targets specifically)
DICTATION_TYPE_DELAY_MS=0
DICTATION_CHUNK_SIZE=0
DICTATION_CHUNK_PAUSE_MS=50

DICTATION_INJECTION_MODE=type
DICTATION_PASTE_KEY_COMBO=ctrl+shift+v
